# Copy to .env and fill locally. Never commit credentials.
MEMORABLE_API_KEY=
# auto uses hosted HTTP when both connection values are set, otherwise local.
# Set local explicitly to use PGLite even when hosted credentials are present.
GBRAIN_TRANSPORT=auto
# Hosted workspace memory. Use the endpoint and unmasked bearer token approved
# for this app; the adapter only writes pages under pacman-memory/.
GBRAIN_MCP_URL=
GBRAIN_ACCESS_TOKEN=
# Optional; default is ./data/gbrain-home (parent of its .gbrain directory).
GBRAIN_HOME=
GBRAIN_BIN=
